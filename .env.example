# GEMINI_API_KEY: Required for Gemini AI API calls (Backend / Server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: FastAPI backend base URL (leave empty to use same-origin /api proxy or Demo Simulation fallback)
VITE_API_BASE_URL=""

# VITE_SUPABASE_URL: Supabase Project URL for Storage & Realtime subscriptions
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase public anon key for client Realtime/Auth
VITE_SUPABASE_ANON_KEY=""
